---
Checks: >
    *, -abseil-*, -altera-*, -android-*, -fuchsia-*, -google-*, -llvm-*,
    -misc-header-include-cycle,
    -llvmlibc-*, -zircon-*, readability-*, modernize-*,
    -readability-else-after-return,
    -readability-static-accessed-through-instance,
    -readability-identifier-length, -readability-avoid-const-params-in-decls,
    -cppcoreguidelines-non-private-member-variables-in-classes,
    -misc-non-private-member-variables-in-classes,
    -modernize-return-braced-init-list, -modernize-use-trailing-return-type,
    -cppcoreguidelines-pro-bounds-constant-array-index,
    -cppcoreguidelines-pro-bounds-array-to-pointer-decay, -hicpp-no-array-decay,
    modernize-use-nodiscard, bugprone-unused-return-value

WarningsAsErrors: ''
HeaderFilterRegex: '(src|include)/.*'
FormatStyle: file

CheckOptions:
    # Namespaces
    - key: readability-identifier-naming.NamespaceCase
      value: lower_case

    # Types
    - key: readability-identifier-naming.ClassCase
      value: CamelCase
    - key: readability-identifier-naming.StructCase
      value: CamelCase
    - key: readability-identifier-naming.EnumCase
      value: CamelCase
    - key: readability-identifier-naming.EnumConstantCase
      value: UPPER_CASE

    # Functions
    - key: readability-identifier-naming.FunctionCase
      value: lower_case
    - key: readability-identifier-naming.MethodCase
      value: lower_case

    # Overrides for Private Methods
    - key: readability-identifier-naming.PrivateMethodCase
      value: lower_case
    - key: readability-identifier-naming.PrivateMethodPrefix
      value: _

    # Overrides for Public/Protected Methods (Explicitly clearing prefix)
    - key: readability-identifier-naming.PublicMethodPrefix
      value: ''
    - key: readability-identifier-naming.ProtectedMethodPrefix
      value: ''

    # Variables
    - key: readability-identifier-naming.VariableCase
      value: lower_case
    - key: readability-identifier-naming.MemberCase
      value: lower_case

    # Overrides for Private Members
    - key: readability-identifier-naming.PrivateMemberCase
      value: lower_case
    - key: readability-identifier-naming.PrivateMemberPrefix
      value: _

    # Overrides for Public/Protected Members (Explicitly clearing prefix)
    - key: readability-identifier-naming.PublicMemberPrefix
      value: ''
    - key: readability-identifier-naming.ProtectedMemberPrefix
      value: ''

    # Parameters
    - key: readability-identifier-naming.ParameterCase
      value: lower_case

    # Constexpr overrides
    - key: readability-identifier-naming.ConstexprVariableCase
      value: UPPER_CASE

    # Global / constants
    - key: readability-identifier-naming.GlobalConstantCase
      value: lower_case
    - key: readability-identifier-naming.ConstantCase
      value: lower_case

    - key: readability-identifier-length.MinimumVariableNameLength
      value: 1

    - key: readability-identifier-length.MinimumParameterNameLength
      value: 1

    # Macros (only UPPER_CASE is sane)
    - key: readability-identifier-naming.MacroDefinitionCase
      value: UPPER_CASE
